async def resolve_member(ctx, target: str):
    if target.isdigit():
        member = ctx.guild.get_member(int(target))
        if member: return member
    if target.startswith("<@") and target.endswith(">"):
        target_id = target.strip("<@!>")
        if target_id.isdigit():
            member = ctx.guild.get_member(int(target_id))
            if member: return member
    if "#" in target:
        name, discrim = target.rsplit("#", 1)
        for m in ctx.guild.members:
            if m.name == name and m.discriminator == discrim:
                return m
    matches = difflib.get_close_matches(target, [m.name for m in ctx.guild.members], n=1, cutoff=0.6)
    if matches:
        return discord.utils.get(ctx.guild.members, name=matches[0])
    return None

