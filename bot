@bot.command()
async def dm(ctx, role: discord.Role, *, message: str):
    if not message.strip():
        return await ctx.send("! Please provide a message to send.")

    members = [member for member in role.members if not member.bot]
    if not members:
        return await ctx.send(f"> No non-bot members found for the role {role.name}.")

    delivered = 0
    failed = 0
    for member in members:
        try:
            await member.send(message)
            delivered += 1
        except (discord.Forbidden, discord.HTTPException):
            failed += 1

    report = discord.Embed(title="DM results", color=0x2b2d31)
    report.add_field(name="Role", value=f"{role.name} ({role.id})", inline=False)
    report.add_field(name="Total Members", value=str(len(members)), inline=True)
    report.add_field(name="Delivered", value=str(delivered), inline=True)
    report.add_field(name="Failed", value=str(failed), inline=True)
    if failed > 0:
        report.add_field(name="Note", value="Some users could not be DM'd. They may have DMs disabled.", inline=False)

    await ctx.send(embed=report)

