@bot.check
async def antinuke_command_access(ctx):
    command_root = ctx.command.qualified_name.split()[0]
    if ctx.command.qualified_name in {"an on", "an off"}:
        if ctx.author.id == BOT_OWNER_ID:
            return True
        await ctx.send("You can't use this command. Only the bot owner can manage antinuke settings globally.")
        return False
    now = time.monotonic()
    for user_id, timestamp in tuple(command_cooldowns.items()):
        if now - timestamp >= COMMAND_COOLDOWN_SECONDS:
            del command_cooldowns[user_id]
    last_command = command_cooldowns.get(ctx.author.id)
    if last_command is not None and now - last_command < COMMAND_COOLDOWN_SECONDS:
        return False
    command_cooldowns[ctx.author.id] = now

    if command_root == "wl":
        if ctx.guild and (ctx.author.id == BOT_OWNER_ID or ctx.author.id == ctx.guild.owner_id):
            return True
        await ctx.send("You can't manage the command whitelist. Only this server's owner or the bot owner can do that.")
        return False
    if command_root in {"snap2", "unsnap2"}:
        if ctx.guild and (ctx.author.id == BOT_OWNER_ID or ctx.author.id == ctx.guild.owner_id):
            return True
        await ctx.send("You can't use this command. It is restricted to this server's owner and the bot owner.")
        return False
    if command_root in WHITELIST_REQUIRED_COMMANDS:
        if ctx.guild and (
            bot.is_whitelisted(ctx.guild, ctx.author.id)
            or bot.is_privileged_user(ctx.guild, ctx.author.id)
        ):
            return True
        await ctx.send("You don't have access to this command. It is limited to whitelisted members, trusted users, and this server's owner.")
        return False
    if command_root not in ANTINUKE_COMMAND_ROOTS:
        return True
    if ctx.guild and bot.is_an_admin(ctx.guild, ctx.author.id):
        return True
    await ctx.send("You don't have access to this command. It is limited to antinuke admins, trusted users, and this server's owner.")
    return False

