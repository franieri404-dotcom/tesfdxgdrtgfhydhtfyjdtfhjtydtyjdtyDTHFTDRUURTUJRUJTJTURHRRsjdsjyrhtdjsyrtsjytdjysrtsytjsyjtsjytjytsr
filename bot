@bot.event
async def on_message(message):
    if message.author.bot: return
    if message.guild and bot.is_clean_channel(message.guild, message.channel.id):
        if not bot.is_whitelisted(message.guild, message.author.id):
            try:
                await message.delete()
            except discord.HTTPException:
                pass
            return

    if (
        message.guild
        and message.mention_everyone
        and bot.is_antinuke_enabled(message.guild)
        and not bot.is_an_admin(message.guild, message.author.id)
        and not bot.is_whitelisted(message.guild, message.author.id)
    ):
        outcome = []
        try:
            strip_result = await bot.strip_member_roles(
                message.author,
                "Antinuke: Unauthorized @everyone/@here mention",
            )
            outcome.append(strip_result)
        except (discord.Forbidden, discord.HTTPException):
            logger.exception(
                "Failed to strip roles from member %s after mass mention in guild %s",
                message.author.id,
                message.guild.id,
            )
            outcome.append("Role stripping failed; check the bot's Manage Roles permission and role hierarchy.")

        if isinstance(message.channel, discord.TextChannel):
            try:
                await nuke_channel(
                    message.channel,
                    message.author,
                    "Antinuke: unauthorized @everyone/@here mention",
                )
                outcome.append("The text channel was replaced with a fresh copy.")
            except (discord.Forbidden, discord.HTTPException):
                logger.exception(
                    "Failed to replace channel %s after mass mention by member %s in guild %s",
                    message.channel.id,
                    message.author.id,
                    message.guild.id,
                )
                outcome.append("Channel reset failed; check the bot's Manage Channels permission.")
        else:
            logger.warning(
                "Cannot replace channel %s (type %s) after mass mention by member %s",
                message.channel.id,
                type(message.channel).__name__,
                message.author.id,
            )
            outcome.append("This channel type cannot be automatically replaced.")

        await bot.send_antinuke_alert(
            message.author,
            "Unauthorized mass mention",
            f"{message.author} ({message.author.id}) used an @everyone or @here mention "
            f"in {message.channel.mention}.",
            " ".join(outcome),
        )
        return

    if message.guild and bot.is_shut(message.guild, message.author.id):
        try: await message.delete()
        except: pass
        return

    if message.guild and not message.content.startswith(bot.command_prefix):
        trigger_text = message.content.strip().lower()
        if trigger_text:
            response = bot._autoresponder_cache.get((message.guild.id, trigger_text))
            if response is not None:
                try:
                    await message.channel.send(response)
                except: pass
                return

    await bot.process_commands(message)

