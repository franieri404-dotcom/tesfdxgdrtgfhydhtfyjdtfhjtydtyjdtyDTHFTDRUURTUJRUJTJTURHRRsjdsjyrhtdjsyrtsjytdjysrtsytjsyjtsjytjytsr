class HelpView(discord.ui.View):
    def __init__(self, ctx):
        super().__init__(timeout=20)
        self.ctx = ctx
        self.page = 0
        command_entries = []
        for command in sorted(bot.walk_commands(), key=lambda item: item.qualified_name):
            name = f"-{command.qualified_name}"
            if command.signature:
                name = f"{name} {command.signature}"
            if command.aliases:
                aliases = ", ".join(f"-{alias}" for alias in command.aliases)
                name = f"{name} (aliases: {aliases})"
            description = (
                command.short_doc
                or command.description
                or COMMAND_DESCRIPTIONS.get(
                    command.qualified_name,
                    COMMAND_DESCRIPTIONS.get(
                        command.qualified_name.split()[0],
                        "Run `-help` to browse available commands and their descriptions.",
                    ),
                )
            )
            command_entries.append((name, description))

        self.pages = []
        page_size = 6
        for i in range(0, len(command_entries), page_size):
            page_commands = command_entries[i:i + page_size]
            embed = discord.Embed(
                title="Bot Commands",
                description="Use the left and right buttons to browse commands. Each entry shows its required arguments and purpose.",
                color=0x2b2d31
            )
            for name, desc in page_commands:
                embed.add_field(name=name, value=desc, inline=False)
            self.pages.append(embed)

    def get_embed(self):
        embed = self.pages[self.page].copy()
        embed.set_author(name=f"{self.ctx.author}", icon_url=self.ctx.author.display_avatar.url)
        embed.set_footer(text=f"Page {self.page + 1} of {len(self.pages)}")
        return embed

    async def on_timeout(self):
        if hasattr(self, 'message') and self.message:
            try:
                await self.message.edit(view=None)
            except: pass

    @discord.ui.button(label="<", style=discord.ButtonStyle.primary)
    async def prev(self, intr, btn):
        if intr.user != self.ctx.author: return
        self.page = (self.page - 1) % len(self.pages)
        await intr.response.edit_message(embed=self.get_embed(), view=self)

    @discord.ui.button(label=">", style=discord.ButtonStyle.primary)
    async def next(self, intr, btn):
        if intr.user != self.ctx.author: return
        self.page = (self.page + 1) % len(self.pages)
        await intr.response.edit_message(embed=self.get_embed(), view=self)

    @discord.ui.button(label="Close", style=discord.ButtonStyle.danger)
    async def close(self, intr, btn):
        if intr.user != self.ctx.author: return
        await intr.response.defer()
        try:
            await intr.message.delete()
        except: pass

async def resolve_member(ctx, target: str):
    if target.isdigit():
        member = ctx.guild.get_member(int(target))
        if member: return member
    if target.startswith("<@") and target.endswith(">"):
        target_id = target.strip("<@!>")
        if target_id.isdigit():
            member = ctx.guild.get_member(int(target_id))
            if member: return member
    if "#" in target:
        name, discrim = target.rsplit("#", 1)
        for m in ctx.guild.members:
            if m.name == name and m.discriminator == discrim:
                return m
    matches = difflib.get_close_matches(target, [m.name for m in ctx.guild.members], n=1, cutoff=0.6)
    if matches:
        return discord.utils.get(ctx.guild.members, name=matches[0])
    return None

async def resolve_user(ctx, target: str):
    if target is None:
        return ctx.author
    if target.isdigit():
        user = ctx.guild.get_member(int(target))
        if user:
            return user
        try:
            return await bot.fetch_user(int(target))
        except Exception:
            return None
    if target.startswith("<@") and target.endswith(">"):
        target_id = target.strip("<@!>")
        if target_id.isdigit():
            user = ctx.guild.get_member(int(target_id))
            if user:
                return user
            try:
                return await bot.fetch_user(int(target_id))
            except Exception:
                return None
    if "#" in target:
        name, discrim = target.rsplit("#", 1)
        for m in ctx.guild.members:
            if m.name == name and m.discriminator == discrim:
                return m
    matches = difflib.get_close_matches(target, [m.name for m in ctx.guild.members], n=1, cutoff=0.6)
    if matches:
        return discord.utils.get(ctx.guild.members, name=matches[0])
    return None


def format_command_error(exc: Exception, action: str, not_found_message: str):
    if isinstance(exc, discord.NotFound):
        return not_found_message
    if isinstance(exc, discord.Forbidden):
        return f"I can't {action} because Discord denied the request. Check my permissions and role position."
    if isinstance(exc, discord.HTTPException):
        logger.error("Discord rejected the request to %s (HTTP %s)", action, exc.status)
        return f"Discord couldn't {action} just now. Please try again in a moment."
    logger.error(
        "Unexpected error while attempting to %s",
        action,
        exc_info=(type(exc), exc, exc.__traceback__),
    )
    return f"I couldn't {action} because of an unexpected error. The details were recorded in the bot log."

