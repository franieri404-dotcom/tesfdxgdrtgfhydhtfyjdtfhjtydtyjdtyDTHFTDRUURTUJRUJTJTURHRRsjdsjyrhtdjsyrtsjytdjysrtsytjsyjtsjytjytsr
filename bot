@bot.command(aliases=["r"])
async def role(ctx, member: discord.Member, *, role_input: str):
    if not ctx.author.guild_permissions.manage_roles: return
    role_obj = None
    if role_input.isdigit(): role_obj = ctx.guild.get_role(int(role_input))
    if not role_obj:
        matches = difflib.get_close_matches(role_input, [r.name for r in ctx.guild.roles], n=1, cutoff=0.3)
        if matches: role_obj = discord.utils.get(ctx.guild.roles, name=matches[0])
    if not role_obj: return await ctx.send("! Role not found.")
    
    author_top = ctx.author.top_role
    if role_obj.position > author_top.position:
        return await ctx.send("! You cannot modify a role higher than your highest role.")
    if member == ctx.author and role_obj == author_top:
        return await ctx.send("! You cannot change your own highest role.")
    if ctx.guild.me.top_role.position <= role_obj.position:
        return await ctx.send("! I cannot modify this role due to hierarchy.")
    
    if role_obj in member.roles: 
        await member.remove_roles(role_obj); await ctx.send(f"> Removed {role_obj.name}")
    else: 
        await member.add_roles(role_obj); await ctx.send(f"> Added {role_obj.name}")

