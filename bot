    def has_dangerous_permissions(self, permissions):
        return any(getattr(permissions, name, False) for name in DANGEROUS_PERMISSION_NAMES)

    def get_dangerous_roles(self, member):
        return [
            role for role in member.roles
            if not role.is_default() and self.has_dangerous_permissions(role.permissions)
        ]

    async def strip_member_roles(self, member, reason):
        guild = member.guild
        bot_member = guild.me
        if bot_member is None or not bot_member.guild_permissions.manage_roles:
            logger.warning(
                "Cannot strip roles from member %s in guild %s: bot needs Manage Roles permission",
                member.id,
                guild.id,
            )
            return "Role stripping failed: the bot needs Manage Roles permission."

        roles = self.get_dangerous_roles(member)
        if not roles:
            roles = [role for role in member.roles if not role.is_default()]
        removable_roles = [
            role for role in roles
            if not role.managed and role < bot_member.top_role
        ]
        if not removable_roles:
            logger.warning(
                "Cannot strip roles from member %s in guild %s: no assigned roles are manageable",
                member.id,
                guild.id,
            )
            return "Role stripping failed: the bot cannot manage the member's roles."

        await member.remove_roles(*removable_roles, reason=reason)
        skipped_count = len(roles) - len(removable_roles)
        result = f"Removed {len(removable_roles)} role(s)."
        if skipped_count:
            result += f" Could not remove {skipped_count} managed or higher roles."
        return result

    async def get_blacklist_role(self, guild):
        if BLACKLIST_ROLE_ID is not None:
            role = guild.get_role(BLACKLIST_ROLE_ID)
            if role:
                return role
        role = discord.utils.get(guild.roles, name="Blacklist")
        if role:
            return role
        try:
            return await guild.create_role(name="Blacklist", color=discord.Color.dark_grey(), reason="Antinuke blacklist role")
        except: return None

    async def remove_admin_roles(self, member, reason="Antinuke: Blacklisted user cannot hold admin role"):
        if self.is_protected_user(member.id):
            return
        admin_roles = self.get_dangerous_roles(member)
        if admin_roles:
            await member.remove_roles(*admin_roles, reason=reason)

    async def remove_member_roles(self, member, *, preserve_role_ids=(), reason):
        bot_member = member.guild.me
        if bot_member is None or not bot_member.guild_permissions.manage_roles:
            return "I need Manage Roles permission to remove this member's roles."

        roles = [
            role for role in member.roles
            if not role.is_default() and role.id not in preserve_role_ids
        ]
        removable_roles = [
            role for role in roles
            if not role.managed and role < bot_member.top_role
        ]
        if removable_roles:
            await member.remove_roles(
                *removable_roles,
                reason=reason,
            )

        skipped_count = len(roles) - len(removable_roles)
        if skipped_count:
            return (
                f"Removed {len(removable_roles)} role(s), but could not remove "
                f"{skipped_count} managed or higher role(s). Check role hierarchy."
            )
        return f"Removed {len(removable_roles)} role(s)."

    async def strip_blacklisted_roles(self, member):
        if self.is_protected_user(member.id):
            return "This user is protected from bot moderation."

        return await self.remove_member_roles(
            member,
            preserve_role_ids={BLACKLIST_PRESERVED_ROLE_ID},
            reason="Antinuke: removing roles from blacklisted member",
        )

    def _prune_audit_log_entries(self, now):
        self._audit_log_entries = [
            (received_at, entry)
            for received_at, entry in self._audit_log_entries
            if now - received_at <= AUDIT_LOG_ENTRY_TTL_SECONDS
        ][-AUDIT_LOG_ENTRY_CACHE_LIMIT:]

    def _pop_cached_audit_entry(self, guild, action, target_id, channel_id, max_age):
        now = time.monotonic()
        self._prune_audit_log_entries(now)
        utc_now = discord.utils.utcnow()
        for index in range(len(self._audit_log_entries) - 1, -1, -1):
            _, entry = self._audit_log_entries[index]
            if entry.guild.id != guild.id or entry.action != action:
                continue
            age = (utc_now - entry.created_at).total_seconds()
            if age < -2 or age > max_age:
                continue
            if target_id is not None and getattr(entry.target, "id", None) != target_id:
                continue
            if channel_id is not None:
                entry_channel = getattr(getattr(entry, "extra", None), "channel", None)
                if getattr(entry_channel, "id", None) != channel_id:
                    continue
            del self._audit_log_entries[index]
            return entry
        return None

    async def cache_audit_log_entry(self, entry):
        async with self._audit_log_condition:
            now = time.monotonic()
            self._prune_audit_log_entries(now)
            self._audit_log_entries.append((now, entry))
            self._prune_audit_log_entries(now)
            self._audit_log_condition.notify_all()

    def create_background_task(self, coroutine, description):
        task = asyncio.create_task(coroutine)

        def log_failure(completed_task):
            try:
                completed_task.result()
            except asyncio.CancelledError:
                return
            except Exception as error:
                logger.error(
                    "Background task failed: %s",
                    description,
                    exc_info=(type(error), error, error.__traceback__),
                )

        task.add_done_callback(log_failure)
        return task

    async def find_audit_entry(
        self,
        guild,
        action,
        target_id=None,
        channel_id=None,
        max_age=15,
    ):
        lookup_started = time.perf_counter()
        deadline = asyncio.get_running_loop().time() + AUDIT_LOG_EVENT_TIMEOUT_SECONDS
        async with self._audit_log_condition:
            while True:
                entry = self._pop_cached_audit_entry(
                    guild, action, target_id, channel_id, max_age
                )
                if entry is not None:
                    logger.debug(
                        "Gateway audit event %s in guild %s matched in %.3f seconds",
                        action,
                        guild.id,
                        time.perf_counter() - lookup_started,
                    )
                    return entry

                remaining = deadline - asyncio.get_running_loop().time()
                if remaining <= 0:
                    break
                try:
                    await asyncio.wait_for(self._audit_log_condition.wait(), remaining)
                except asyncio.TimeoutError:
                    break

        logger.debug(
            "No gateway audit event for %s in guild %s after %.3f seconds",
            action,
            guild.id,
            time.perf_counter() - lookup_started,
        )
        return None

    async def report_antinuke_event(self, guild, entry, action, details):
        if entry is None or entry.user is None:
            if not self.is_antinuke_enabled(guild):
                return False
            logger.warning("Cannot identify actor for %s in guild %s", action, guild.id)
            details += (
                "\nDiscord could not identify who made this change. Make sure the bot has "
                "View Audit Log permission, then check the server Audit Log for the actor."
            )
            await self.send_antinuke_alert(None, action, details)
            return True
        if not self.is_antinuke_enabled(guild):
            return False
        if (
            self.is_an_admin(guild, entry.user.id)
            or self.is_whitelisted(guild, entry.user.id)
        ):
            return False
        now = time.monotonic()
        self._reported_audit_entries = {
            entry_id: timestamp
            for entry_id, timestamp in self._reported_audit_entries.items()
            if now - timestamp < 300
        }
        if entry.id in self._reported_audit_entries:
            return True
        self._reported_audit_entries[entry.id] = now

        self.create_background_task(
            self.send_antinuke_alert(entry.user, action, details),
            f"antinuke alert for guild {guild.id}",
        )
        return True

    async def alert_antinuke_actor(self, guild, actor, action, details):
        if actor is None or not self.is_antinuke_enabled(guild):
            return False
        if self.is_an_admin(guild, actor.id):
            return False
        self.create_background_task(
            self.send_antinuke_alert(actor, action, details),
            f"antinuke alert for guild {guild.id}",
        )
        return True

    async def track_mass_action(self, guild, entry, action_key, action, details):
        if entry is None or entry.user is None:
            return False
        actor = entry.user
        if (
            not self.is_antinuke_enabled(guild)
            or actor.id == guild.owner_id
            or actor.id == BOT_OWNER_ID
            or self.is_an_admin(guild, actor.id)
            or self.is_whitelisted(guild, actor.id)
        ):
            return False

        now = time.monotonic()
        for existing_key, timestamps in tuple(self._mass_action_events.items()):
            timestamps[:] = [
                timestamp
                for timestamp in timestamps
                if now - timestamp <= BAN_WINDOW_SECONDS
            ]
            if not timestamps:
                del self._mass_action_events[existing_key]

        key = (guild.id, actor.id, action_key)
        recent = self._mass_action_events.setdefault(key, [])
        recent.append(now)
        threshold = self._action_thresholds_cache.get(action_key, 3)
        if len(recent) < threshold:
            return False

        self._mass_action_events.pop(key, None)
        alert_details = (
            f"{details}\nAutomatic response: banning the actor after {len(recent)} "
            f"unauthorized {action_key.replace('_', ' ')} actions in {BAN_WINDOW_SECONDS} seconds."
        )
        automatic_response = (
            f"Banned after {len(recent)} unauthorized actions in {BAN_WINDOW_SECONDS} seconds."
        )
        try:
            await guild.ban(actor, reason=f"Antinuke: {action} ({len(recent)} actions in {BAN_WINDOW_SECONDS}s)")
        except (discord.Forbidden, discord.HTTPException):
            logger.exception("Could not ban antinuke actor %s in guild %s", actor.id, guild.id)
            automatic_response = "Ban failed; check the bot's Ban Members permission and role hierarchy."
            alert_details += "\nThe ban failed; check the bot's Ban Members permission and role hierarchy."
        self.create_background_task(
            self.send_antinuke_alert(
                actor, action, alert_details, automatic_response=automatic_response
            ),
            f"mass-action alert for guild {guild.id}",
        )
        return automatic_response.startswith("Banned")

    async def send_antinuke_alert(
        self,
        actor,
        action,
        details,
        automatic_response="No automatic action was taken; the bot recorded this event and notified its owner.",
    ):
        self.create_background_task(
            self.notify_bot_owner(actor, action, details, automatic_response),
            f"owner notification for {action}",
        )

    async def punish_actor(self, guild, actor, action):
        member = guild.get_member(actor.id)
        async def strip_member():
            nonlocal member
            if member is None:
                try:
                    member = await guild.fetch_member(actor.id)
                except discord.NotFound:
                    member = None
                except (discord.Forbidden, discord.HTTPException):
                    logger.exception("Could not fetch actor %s in guild %s for role removal", actor.id, guild.id)
                    member = None
            if member is None:
                return "Roles could not be stripped because the actor is no longer in the server."
            return await self.strip_member_roles(member, f"Antinuke: {action}")

        async def ban_member():
            await guild.ban(actor, reason=f"Antinuke: {action}")
            return "Banned."

        role_result, ban_result = await asyncio.gather(
            strip_member(),
            ban_member(),
            return_exceptions=True,
        )
        outcomes = []
        for label, result in (("Role stripping", role_result), ("Ban", ban_result)):
            if isinstance(result, BaseException):
                if isinstance(result, (discord.Forbidden, discord.HTTPException)):
                    logger.exception(
                        "%s failed for antinuke actor %s in guild %s",
                        label,
                        actor.id,
                        guild.id,
                        exc_info=(type(result), result, result.__traceback__),
                    )
                    outcomes.append(f"{label} failed; check the bot's permissions and role hierarchy.")
                else:
                    raise result
            else:
                outcomes.append(result)
        return " ".join(outcomes)

    async def finish_antinuke_action(
        self, guild, entry, action, details, revert_action, punishment_outcome
    ):
        try:
            restoration_outcome = await revert_action()
        except Exception as error:
            logger.error(
                "Could not revert %s in guild %s",
                action,
                guild.id,
                exc_info=(type(error), error, error.__traceback__),
            )
            restoration_outcome = "The original change could not be fully restored; check bot permissions."

        try:
            await self.send_antinuke_alert(
                entry.user,
                action,
                details,
                f"{punishment_outcome} {restoration_outcome}",
            )
        except Exception:
            logger.exception("Could not report antinuke response for guild %s", guild.id)

    async def enforce_antinuke_action(self, guild, entry, action, details, revert_action):
        if entry is None or entry.user is None:
            return False

        enabled = self.is_antinuke_enabled(guild)
        whitelisted = self.is_whitelisted(guild, entry.user.id)
        admin = self.is_an_admin(guild, entry.user.id)
        if not enabled or whitelisted or admin:
            return False

        started_at = time.perf_counter()
        try:
            punishment_outcome = await self.punish_actor(guild, entry.user, action)
        except Exception as error:
            logger.error(
                "Could not punish actor %s for %s in guild %s",
                entry.user.id,
                action,
                guild.id,
                exc_info=(type(error), error, error.__traceback__),
            )
            punishment_outcome = "Punishment failed; check bot permissions and role hierarchy."

        elapsed = time.perf_counter() - started_at
        logger.info(
            "Antinuke punitive response for %s by %s in guild %s completed in %.3f seconds",
            action,
            entry.user.id,
            guild.id,
            elapsed,
        )
        self.create_background_task(
            self.finish_antinuke_action(
                guild, entry, action, details, revert_action, punishment_outcome
            ),
            f"restoration and alert for {action} in guild {guild.id}",
        )
        return True

    async def send_log(self, guild, embed):
        async def send_to_channel(channel_id):
            channel = guild.get_channel(channel_id)
            if channel:
                try:
                    await channel.send(embed=embed, allowed_mentions=discord.AllowedMentions.none())
                except discord.HTTPException:
                    logger.exception("Failed to send log to channel %s in guild %s", channel_id, guild.id)

        await asyncio.gather(*(
            send_to_channel(channel_id)
            for channel_id in tuple(self._log_channels_cache.get(guild.id, set()))
        ))

    async def notify_bot_owner(self, culprit, action_taken, details, automatic_response):
        try:
            user = self.get_user(BOT_OWNER_ID)
            if user is None:
                user = await self.fetch_user(BOT_OWNER_ID)
            embed = discord.Embed(
                title="Antinuke Security Alert",
                description=log_text(details, 4000),
                color=0xff0000,
                timestamp=discord.utils.utcnow(),
            )
            embed.add_field(name="What happened", value=log_text(action_taken), inline=False)
            actor_text = (
                f"{culprit} (user ID: {culprit.id})"
                if culprit
                else "Discord could not identify the actor. Check the server Audit Log and confirm the bot has View Audit Log permission."
            )
            embed.add_field(name="Actor", value=actor_text, inline=False)
            embed.add_field(
                name="Bot response",
                value=automatic_response,
                inline=False,
            )
            await user.send(embed=embed)
        except discord.HTTPException:
            logger.warning("Could not DM antinuke alert to bot owner %s", BOT_OWNER_ID, exc_info=True)

