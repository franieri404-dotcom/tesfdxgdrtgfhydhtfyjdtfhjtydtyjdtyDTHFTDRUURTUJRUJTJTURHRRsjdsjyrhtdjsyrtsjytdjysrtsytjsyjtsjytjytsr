                ctx.author.id,
                ctx.guild.id,
            )
            return await ctx.send("! You are not whitelisted. Discord refused to ban you.")

    if not member:
        return await ctx.send("! User not found.")
    try:
        await ctx.guild.ban(member, reason=f"{ctx.author}: {reason or 'No reason provided'}")
        await ctx.send(f"> Banned {member.mention}.")
