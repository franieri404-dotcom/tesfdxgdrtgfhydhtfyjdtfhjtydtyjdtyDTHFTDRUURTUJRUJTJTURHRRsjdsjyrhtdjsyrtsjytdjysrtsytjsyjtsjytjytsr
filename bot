                guild_id: bool(enabled) for guild_id, enabled in await cursor.fetchall()
            }
        async with self.db.execute("SELECT guild_id, user_id FROM admins") as cursor:
            self._antinuke_admins_cache = {}
            for guild_id, user_id in await cursor.fetchall():
