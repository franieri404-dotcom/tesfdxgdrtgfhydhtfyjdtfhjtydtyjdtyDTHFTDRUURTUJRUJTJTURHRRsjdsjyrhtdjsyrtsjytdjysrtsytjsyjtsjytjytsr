async def unban(ctx, *, target: str):
    if not ctx.author.guild_permissions.ban_members: return
    target_id = target.strip("<@!>") if target.startswith("<@") else target
    user_id = None
    
    if target_id.isdigit():
        user_id = int(target_id)
        user = discord.Object(id=user_id)
    else:
        bans = await ctx.guild.bans()
        name, discrim = target.rsplit("#", 1) if "#" in target else (target, None)
        user = None
        for ban in bans:
            if ban.user.name == name and (discrim is None or ban.user.discriminator == discrim):
                user = ban.user
                user_id = ban.user.id
                break
        if user is None:
            return await ctx.send("! Banned user not found.")
    
    if user_id and bot.is_executed(ctx.guild, user_id):
        return await ctx.send("user is executed, use -pardon")
    
    try:
        await ctx.guild.unban(user)
        display = getattr(user, 'mention', None) or f"<@{user_id}>"
        await ctx.send(f"> Unbanned {display}.")
    except Exception as e:
