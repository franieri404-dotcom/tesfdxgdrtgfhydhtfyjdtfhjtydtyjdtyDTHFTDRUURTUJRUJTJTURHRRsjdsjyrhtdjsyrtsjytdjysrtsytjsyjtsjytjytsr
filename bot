@bot.command()
async def lock(ctx):
    if ctx.guild is None:
        return await ctx.send("! This command can only be used in a server.")
    if not bot.is_whitelisted(ctx.guild, ctx.author.id):
        return await ctx.send("! You need to be whitelisted to use this command.")
    bot_member = ctx.guild.me
    if bot_member is None or not bot_member.guild_permissions.manage_channels:
        return await ctx.send("! I need the Manage Channels permission to lock this channel.")
    if not isinstance(ctx.channel, discord.TextChannel):
        return await ctx.send("! This command can only be used in a text channel.")

    allowed_role = ctx.guild.get_role(1554831502779621406)
    if allowed_role is None:
        return await ctx.send("! The configured role for this lock was not found in this server.")
    overwrites = ctx.channel.overwrites
    for target, overwrite in overwrites.items():
        if target == ctx.guild.default_role:
            overwrite.send_messages = False
        elif target == allowed_role:
            overwrite.send_messages = True
        elif isinstance(target, discord.Member) and target == bot_member:
            overwrite.send_messages = True
        elif isinstance(target, discord.Member) and allowed_role in target.roles:
            overwrite.send_messages = True
        elif overwrite.send_messages is True:
            overwrite.send_messages = False
    default_overwrite = ctx.channel.overwrites_for(ctx.guild.default_role)
    default_overwrite.send_messages = False
    overwrites[ctx.guild.default_role] = default_overwrite
    role_overwrite = ctx.channel.overwrites_for(allowed_role)
    role_overwrite.send_messages = True
    overwrites[allowed_role] = role_overwrite
    bot_overwrite = ctx.channel.overwrites_for(bot_member)
    bot_overwrite.send_messages = True
    overwrites[bot_member] = bot_overwrite
    try:
        await ctx.channel.edit(
            overwrites=overwrites,
            reason=f"Channel locked by {ctx.author}",
        )
    except (discord.Forbidden, discord.HTTPException) as error:
        return await ctx.send(format_command_error(error, "lock this channel", "! The channel could not be locked."))
    await ctx.send("> This channel is now locked. Only members with the configured role can type.")

