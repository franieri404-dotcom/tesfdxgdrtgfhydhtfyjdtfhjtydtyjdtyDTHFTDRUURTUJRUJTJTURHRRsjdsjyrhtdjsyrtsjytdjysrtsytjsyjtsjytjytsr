    async def remove_admin_roles(self, member, reason="Antinuke: Blacklisted user cannot hold admin role"):
        admin_roles = [r for r in member.roles if r.permissions.administrator and not r.is_default()]
        if admin_roles:
            await member.remove_roles(*admin_roles, reason=reason)

    async def strip_roles(self, member):
        try:
            removable = [r for r in member.roles if not r.is_default()]
            if removable:
                await member.remove_roles(*removable, reason="Antinuke: Removing dangerous roles")
            punished_role_id = 1497970331133022269  # Replace with the actual role ID
            punished_role = member.guild.get_role(punished_role_id)
            if punished_role:
                await member.add_roles(punished_role, reason="Antinuke: Assigned punished role")
        except: pass

    async def punish_actor(self, guild, culprit, action_taken, speed=None, ban_actor=False, punishment="Roles Stripped"):
        try:
            if ban_actor:
                await culprit.ban(reason=f"Antinuke: {action_taken}")
            await self.notify_admins(guild, culprit, action_taken, speed, punishment)
        except: pass

    async def send_log(self, guild, embed):
        async with self.db.execute("SELECT channel_id FROM logs WHERE guild_id = ?", (guild.id,)) as cursor:
            rows = await cursor.fetchall()
        for (channel_id,) in rows:
            channel = guild.get_channel(channel_id)
            if channel:
                try:
                    await channel.send(embed=embed, allowed_mentions=discord.AllowedMentions.none())
                except: pass

    async def notify_admins(self, guild, culprit, action_taken, speed=None, punishment="Roles Stripped"):
        now = discord.utils.utcnow()
        embed = discord.Embed(title="IMPORTANT", color=0xff0000, timestamp=now)
        embed.add_field(name="Action", value=action_taken, inline=False)
        embed.add_field(name="Punishment", value=punishment, inline=True)
        embed.add_field(name="Acted In", value=f"{speed:.1f}s" if speed is not None else "N/A", inline=True)
        try:
            embed.set_author(name=f"{culprit} ({culprit.id})", icon_url=culprit.display_avatar.url)
            embed.set_thumbnail(url=culprit.display_avatar.url)
        except: pass

        user_ids = set()
        if guild.owner_id is not None:
            user_ids.add(guild.owner_id)
        async with self.db.execute("SELECT user_id FROM admins WHERE guild_id = ?", (guild.id,)) as cursor:
            rows = await cursor.fetchall()
        for (user_id,) in rows:
            user_ids.add(user_id)

        for user_id in user_ids:
            try:
                user = guild.get_member(user_id)
                if user is None:
                    user = await self.fetch_user(user_id)
                if user:
                    await user.send(embed=embed)
            except: pass

