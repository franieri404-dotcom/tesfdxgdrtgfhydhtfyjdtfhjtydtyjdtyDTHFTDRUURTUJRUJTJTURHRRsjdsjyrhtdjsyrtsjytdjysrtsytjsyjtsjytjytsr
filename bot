@bot.command(aliases=["r"])
async def role(ctx, member: str, *, role_input: str):
    remote_role_args = role_input.split()
    remote_target = (
        member.isdigit()
        and len(remote_role_args) == 2
        and all(value.isdigit() for value in remote_role_args)
    )
    target_guild = ctx.guild

    if remote_target:
        if ctx.author.id != BOT_OWNER_ID:
            return await ctx.send("! Only the bot owner can change roles across servers.")
        target_guild = bot.get_guild(int(member))
        if target_guild is None:
            return await ctx.send("! I am not in that server, or the server ID is invalid.")
        if target_guild.me is None or not target_guild.me.guild_permissions.manage_roles:
            return await ctx.send("! I need Manage Roles permission in the selected server.")
        role_obj = target_guild.get_role(int(remote_role_args[0]))
        target_member = await resolve_member_in_guild(target_guild, int(remote_role_args[1]))
        if role_obj is None:
            return await ctx.send("! Role not found.")
        if target_member is None:
            return await ctx.send("! User not found.")
    else:
        if ctx.guild is None:
            return await ctx.send("! Use `-role <server_id> <role_id> <user_id>` in DMs.")
        if not ctx.author.guild_permissions.manage_roles:
            return
        target_member = await resolve_member(ctx, member)
        if not target_member:
            return await ctx.send("! User not found.")
        role_obj = None
        if role_input.isdigit():
            role_obj = ctx.guild.get_role(int(role_input))
        if not role_obj:
            matches = difflib.get_close_matches(role_input, [r.name for r in ctx.guild.roles], n=1, cutoff=0.3)
            if matches:
                role_obj = discord.utils.get(ctx.guild.roles, name=matches[0])
        if not role_obj:
            return await ctx.send("! Role not found.")

    if bot.is_protected_user(target_member.id):
        return await ctx.send("! This user is protected from bot moderation.")
    if not remote_target:
        author_top = ctx.author.top_role
        if role_obj.position > author_top.position:
            return await ctx.send("! You cannot modify a role higher than your highest role.")
        if target_member == ctx.author and role_obj == author_top:
            return await ctx.send("! You cannot change your own highest role.")
    if target_guild.me.top_role.position <= role_obj.position:
        return await ctx.send("! I cannot modify this role due to hierarchy.")
    
    if role_obj in target_member.roles: 
        await target_member.remove_roles(role_obj); await ctx.send(f"> Removed {role_obj.name}")
    else: 
        if bot.is_blacklisted(target_guild, target_member.id):
            return await ctx.send("! Blacklisted members cannot receive roles.")
        await target_member.add_roles(role_obj); await ctx.send(f"> Added {role_obj.name}")

@bot.command()
async def pic(ctx, member: discord.Member):
    if not ctx.author.guild_permissions.manage_roles:
        return await ctx.send("! You need the Manage Roles permission to use this command.")
    if bot.is_protected_user(member.id):
        return await ctx.send("! This user is protected from bot moderation.")

    role_obj = ctx.guild.get_role(1554568736118280223)
    if role_obj is None:
        return await ctx.send("! The configured role could not be found in this server.")
    if role_obj >= ctx.author.top_role:
        return await ctx.send("! You cannot modify a role equal to or higher than your highest role.")
    if role_obj >= ctx.guild.me.top_role:
        return await ctx.send("! I cannot modify this role due to role hierarchy.")

    removing = role_obj in member.roles
    if not removing and bot.is_blacklisted(ctx.guild, member.id):
        return await ctx.send("! Blacklisted members cannot receive roles.")
    action = "remove" if removing else "assign"
    failure_message = "! The role could not be removed." if removing else "! The role could not be assigned."
    try:
        if removing:
            await member.remove_roles(role_obj, reason=f"Removed with -pic by {ctx.author}")
        else:
            await member.add_roles(role_obj, reason=f"Assigned with -pic by {ctx.author}")
    except (discord.Forbidden, discord.HTTPException) as error:
        return await ctx.send(format_command_error(error, f"{action} the role", failure_message))
    verb = "Removed" if removing else "Added"
    await ctx.send(f"> {verb} {role_obj.name} {'from' if removing else 'to'} {member.mention}.")

