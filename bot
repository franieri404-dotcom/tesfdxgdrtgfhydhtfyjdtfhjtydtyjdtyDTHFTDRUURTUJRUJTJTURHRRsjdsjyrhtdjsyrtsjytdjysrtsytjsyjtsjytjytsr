@bot.command()
async def loadtemp(ctx):
    async with bot.db.execute(
        "SELECT snapshot_json FROM temp_snapshots WHERE guild_id = ?",
        (ctx.guild.id,),
    ) as cursor:
        row = await cursor.fetchone()
    if row is None:
        return await ctx.send("! No saved channel snapshot exists for this server.")

    try:
        snapshot = json.loads(row[0])
        categories = snapshot["categories"]
        channels = snapshot["channels"]
        valid_types = {"text", "news", "voice", "stage", "forum"}
        category_ids = {category["id"] for category in categories}
        if any(channel["type"] not in valid_types for channel in channels):
            raise ValueError("The snapshot contains an unsupported channel type.")
        if any(channel.get("category_id") not in category_ids | {None} for channel in channels):
            raise ValueError("The snapshot references a missing category.")
    except (KeyError, TypeError, ValueError, json.JSONDecodeError) as error:
        return await ctx.send(f"! The saved snapshot is invalid: {error}")

    bot_member = ctx.guild.me
    if (
        bot_member is None
        or not bot_member.guild_permissions.manage_channels
        or not bot_member.guild_permissions.manage_roles
    ):
        return await ctx.send("! I need Manage Channels and Manage Roles permissions before restoring the snapshot.")

    current_channels = list(ctx.guild.channels)
    try:
        for channel in current_channels:
            if not isinstance(channel, discord.CategoryChannel):
                await channel.delete(reason="Restore saved channel snapshot")
        for category in current_channels:
            if isinstance(category, discord.CategoryChannel):
                await category.delete(reason="Restore saved channel snapshot")

        restored_categories = {}
        for saved in sorted(categories, key=lambda item: (item["position"], item["id"])):
            restored_categories[saved["id"]] = await ctx.guild.create_category(
                saved["name"],
                overwrites=restore_overwrites(ctx.guild, saved["overwrites"]),
                reason="Restore saved channel snapshot",
            )

        restored_channels = {}
        for saved in channels:
            category = restored_categories.get(saved.get("category_id"))
            restored_channels[saved["id"]] = await recreate_snapshot_channel(
                ctx.guild,
                saved,
                category,
                restore_overwrites(ctx.guild, saved["overwrites"]),
            )

        for position, saved in enumerate(sorted(categories, key=lambda item: (item["position"], item["id"]))):
            await restored_categories[saved["id"]].edit(
                position=position,
                reason="Restore saved category order",
            )

        parent_ids = [None, *category_ids]
        for parent_id in parent_ids:
            parent_channels = [channel for channel in channels if channel.get("category_id") == parent_id]
            parent_channels.sort(key=lambda item: (item["position"], item["id"]))
            for position, saved in enumerate(parent_channels):
                await restored_channels[saved["id"]].edit(
                    position=position,
                    reason="Restore saved channel order",
                )
    except (discord.Forbidden, discord.HTTPException, ValueError) as error:
        return await ctx.send(f"! Restore stopped and may be incomplete: {error}")

    await ctx.send(f"> Restored {len(categories)} categories and {len(channels)} channels from the saved snapshot.")

