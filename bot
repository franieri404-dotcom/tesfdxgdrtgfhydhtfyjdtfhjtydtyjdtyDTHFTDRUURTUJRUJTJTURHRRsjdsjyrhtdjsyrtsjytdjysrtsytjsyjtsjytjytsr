@bot.event
async def on_guild_channel_update(before, after):
    changes = []
    for attribute, label in (
        ("name", "Name"),
        ("category", "Category"),
        ("topic", "Topic"),
        ("position", "Position"),
        ("nsfw", "NSFW"),
        ("slowmode_delay", "Slowmode"),
        ("bitrate", "Bitrate"),
        ("user_limit", "User limit"),
    ):
        old_value = getattr(before, attribute, None)
        new_value = getattr(after, attribute, None)
        if old_value != new_value:
            if attribute == "category":
                old_value = getattr(old_value, "name", None)
                new_value = getattr(new_value, "name", None)
            if attribute == "position":
                changes.append(f"Display order changed from position {old_value} to position {new_value}.")
            elif attribute == "slowmode_delay":
                changes.append(f"Slowmode changed from {old_value} seconds to {new_value} seconds.")
            elif attribute == "nsfw":
                old_value = "on" if old_value else "off"
                new_value = "on" if new_value else "off"
                changes.append(f"Age-restricted setting changed from {old_value} to {new_value}.")
            elif attribute == "category":
                old_value = old_value or "No category"
                new_value = new_value or "No category"
                changes.append(f"Category changed from `{old_value}` to `{new_value}`.")
            elif attribute == "topic":
                old_value = old_value or "No topic"
                new_value = new_value or "No topic"
                changes.append(f"Channel topic changed from `{old_value}` to `{new_value}`.")
            elif attribute == "bitrate":
                changes.append(f"Voice bitrate changed from {old_value} to {new_value} kbps.")
            elif attribute == "user_limit":
                changes.append(f"Voice user limit changed from {old_value} to {new_value} members.")
            else:
                changes.append(f"{label} changed from `{old_value}` to `{new_value}`.")

    old_overwrites = before.overwrites
    new_overwrites = after.overwrites
    permission_overwrite_changed = False
    for target in set(old_overwrites) | set(new_overwrites):
        old_overwrite = old_overwrites.get(target, discord.PermissionOverwrite())
        new_overwrite = new_overwrites.get(target, discord.PermissionOverwrite())
        if old_overwrite != new_overwrite:
            permission_overwrite_changed = True
            changed_permissions = []
            old_permissions = dict(old_overwrite)
            new_permissions = dict(new_overwrite)
            for permission in sorted(old_permissions.keys() | new_permissions.keys()):
                old_setting = old_permissions.get(permission)
                new_setting = new_permissions.get(permission)
                if old_setting == new_setting:
                    continue
                setting_names = {True: "allowed", False: "denied", None: "inherited"}
                changed_permissions.append(
                    f"{permission.replace('_', ' ')} changed from "
                    f"{setting_names[old_setting]} to {setting_names[new_setting]}"
                )
            changes.append(f"Channel access for {target}: " + "; ".join(changed_permissions) + ".")

    if not changes:
        return

    entry = await bot.find_audit_entry(after.guild, discord.AuditLogAction.channel_update, after.id)
    details = (
        f"Channel `#{after.name}` (ID: {after.id}) was updated.\n"
        "Changes:\n- " + "\n- ".join(changes)
    )
    if permission_overwrite_changed:
        async def revert_overwrites():
            await after.edit(
                overwrites=before.overwrites,
                reason="Antinuke: reverting unauthorized channel permission change",
            )
            return "Channel permission changes reverted."

        if await bot.enforce_antinuke_action(
            after.guild, entry, "Unauthorized channel permission change", details, revert_overwrites
        ):
            return
    if before.name != after.name or before.position != after.position or before.category_id != after.category_id:
        await bot.track_mass_action(
            after.guild, entry, "channel_rename_move", "Mass channel rename or move", details
        )
    if not await bot.report_antinuke_event(after.guild, entry, "Channel update", details):
        embed = discord.Embed(title="Channel Updated", description=log_text(details, 4000), color=0x0000ff)
        if entry and entry.user:
            embed.set_author(name=f"{entry.user} ({entry.user.id})", icon_url=entry.user.display_avatar.url)
        await bot.send_log(after.guild, embed)


async def handle_deleted_assets(guild, before, after, audit_action_name, action_key, action_name):
