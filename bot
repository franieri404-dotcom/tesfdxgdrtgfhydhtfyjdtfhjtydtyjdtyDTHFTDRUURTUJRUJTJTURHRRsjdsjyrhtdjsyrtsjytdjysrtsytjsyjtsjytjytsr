async def resolve_target_guild(ctx, guild_id=None):
    if guild_id is None:
        guild = ctx.guild
    else:
        guild = bot.get_guild(guild_id)
    if guild is None:
        if guild_id is None:
            await ctx.send("Use this command in a server, or provide a guild ID when running it in DMs.")
        else:
            await ctx.send("I am not in that server, or the guild ID is invalid.")
        return None
    return guild


async def resolve_member_in_guild(guild, user_id):
    member = guild.get_member(user_id)
    if member is not None:
        return member
    try:
        return await guild.fetch_member(user_id)
    except discord.NotFound:
        return None


def log_text(value, limit=1024):
    if value is None:
        return "(none)"
    text = str(value)
    if not text:
        return "(empty)"
    return text if len(text) <= limit else text[:limit - 3] + "..."


