class RolesView(discord.ui.View):
    def __init__(self, ctx, roles):
        super().__init__(timeout=30)
        self.ctx, self.roles, self.page = ctx, roles, 0
        self.max_pages = (len(roles) - 1) // 10

    def get_emb(self):
        start = self.page * 10
        chunk = self.roles[start:start+10]
        desc = "\n".join([f"**{i+1}** {r.mention}" for i, r in enumerate(chunk, start=start)])
        embed = discord.Embed(title="Roles", description=desc or "No roles found", color=0x2b2d31)
        embed.set_author(name=self.ctx.author.name, icon_url=self.ctx.author.display_avatar.url)
        embed.set_footer(text=f"Page {self.page+1}/{self.max_pages+1} ({len(self.roles)} entries)")
        return embed

    @discord.ui.button(label="<", style=discord.ButtonStyle.primary)
    async def prev(self, intr, btn):
        if intr.user != self.ctx.author: return
        self.page = self.max_pages if self.page == 0 else self.page - 1
        await intr.response.edit_message(embed=self.get_emb())

    @discord.ui.button(label=">", style=discord.ButtonStyle.primary)
    async def next(self, intr, btn):
        if intr.user != self.ctx.author: return
        self.page = 0 if self.page == self.max_pages else self.page + 1
        await intr.response.edit_message(embed=self.get_emb())

    @discord.ui.button(label="X", style=discord.ButtonStyle.danger)
    async def close(self, intr, btn):
        if intr.user != self.ctx.author: return
        await intr.message.delete()

class LogsConfirm(discord.ui.View):
    def __init__(self, ctx):
        super().__init__(timeout=30)
        self.ctx = ctx

    @discord.ui.button(label="Yes", style=discord.ButtonStyle.success)
    async def yes(self, intr, btn):
        if intr.user != self.ctx.author: return
        await intr.response.defer()
        try:
            await self.ctx.channel.edit(name="zainn-v2-logs")
        except:
            pass
        await bot.db.execute("INSERT OR IGNORE INTO logs VALUES (?, ?)", (self.ctx.guild.id, self.ctx.channel.id))
        await bot.db.commit()
        bot._log_channels_cache.setdefault(self.ctx.guild.id, set()).add(self.ctx.channel.id)
        await intr.followup.send(
            "Bot activity logging is now enabled in this channel. I also renamed it to `#zainn-v2-logs`.",
            ephemeral=True,
        )

    @discord.ui.button(label="No", style=discord.ButtonStyle.danger)
    async def no(self, intr, btn):
        if intr.user != self.ctx.author: return
        await intr.response.defer()
        await bot.db.execute("DELETE FROM logs WHERE guild_id = ? AND channel_id = ?", (self.ctx.guild.id, self.ctx.channel.id))
        await bot.db.commit()
        channels = bot._log_channels_cache.get(self.ctx.guild.id)
        if channels is not None:
            channels.discard(self.ctx.channel.id)
            if not channels:
                bot._log_channels_cache.pop(self.ctx.guild.id, None)
        await intr.followup.send("Bot activity logging is now disabled in this channel.", ephemeral=True)

async def nuke_channel(channel, actor, reason):
    embed = discord.Embed(
        title="Channel Nuked",
        description=f"{actor.mention} replaced {channel.mention} with a fresh copy.",
        color=0xff0000
    )
    embed.set_author(name=str(actor), icon_url=actor.display_avatar.url)
    new_channel = await channel.clone(reason=reason)
    await channel.delete()
    bot.create_background_task(
        bot.send_log(channel.guild, embed),
        f"channel replacement log for guild {channel.guild.id}",
    )
    bot.create_background_task(
        new_channel.send("This channel was recreated by the server management command."),
        f"recreated-channel notice for guild {channel.guild.id}",
    )


