@bot.event
async def on_command_error(ctx, error):
    if isinstance(error, commands.CommandOnCooldown):
        await ctx.send(
            f"This command is on cooldown. Try again in {max(1, round(error.retry_after))} seconds."
        )
    elif isinstance(error, (commands.CheckFailure, commands.CommandNotFound)):
        return
    elif isinstance(error, commands.MissingRequiredArgument):
        command = ctx.command
        if command is not None:
            usage = f" Usage: `-{command.qualified_name} {command.signature}`."
        else:
            usage = " Run `-help` to see command formats."
        await ctx.send(
            f"This command is missing the required `{error.param.name}` argument.{usage}"
        )
    elif isinstance(error, commands.BadArgument):
        command = ctx.command
        if command is not None:
            usage = f" Correct format: `-{command.qualified_name} {command.signature}`."
        else:
            usage = " Check `-help` for the correct command format."
        await ctx.send(f"One or more arguments don't match the expected format.{usage}")
    else:
        cause = error.original if isinstance(error, commands.CommandInvokeError) else error
        logger.error(
            "Command %s failed for user %s in guild %s",
            ctx.command.qualified_name if ctx.command else "(unknown)",
            ctx.author.id,
            ctx.guild.id if ctx.guild else "(DM)",
            exc_info=(type(cause), cause, cause.__traceback__),
        )
        await ctx.send(
            "I couldn't complete that command because of an unexpected error. "
            "The details were recorded in the bot log."
        )

