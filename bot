def serialize_overwrites(channel):
    overwrites = []
    for target, overwrite in channel.overwrites.items():
        if isinstance(target, discord.Role):
            target_type = "role"
        elif isinstance(target, discord.Member):
            target_type = "member"
        else:
            continue
        allow, deny = overwrite.pair()
        overwrites.append({
            "type": target_type,
            "id": target.id,
            "allow": allow.value,
            "deny": deny.value,
        })
    return overwrites


def serialize_channel(channel):
    if isinstance(channel, discord.CategoryChannel):
        channel_type = "category"
    elif isinstance(channel, discord.StageChannel):
        channel_type = "stage"
    elif isinstance(channel, discord.ForumChannel):
        channel_type = "forum"
    elif isinstance(channel, discord.VoiceChannel):
        channel_type = "voice"
    elif isinstance(channel, discord.TextChannel):
        channel_type = "news" if channel.is_news() else "text"
    else:
        raise ValueError(f"Unsupported channel type: {type(channel).__name__}")

    data = {
        "id": channel.id,
        "type": channel_type,
        "name": channel.name,
        "position": channel.position,
        "category_id": getattr(channel, "category_id", None),
        "overwrites": serialize_overwrites(channel),
    }
    for attribute in (
        "topic", "nsfw", "slowmode_delay", "bitrate", "user_limit",
        "default_auto_archive_duration", "default_thread_slowmode_delay",
    ):
        value = getattr(channel, attribute, None)
        if value is not None:
            data[attribute] = value
    rtc_region = getattr(channel, "rtc_region", None)
    if rtc_region is not None:
        data["rtc_region"] = getattr(rtc_region, "value", rtc_region)
    video_quality_mode = getattr(channel, "video_quality_mode", None)
    if video_quality_mode is not None:
        data["video_quality_mode"] = video_quality_mode.value
    if channel_type == "forum":
        data["media"] = channel.is_media()
        data["available_tags"] = [
            {
                "name": tag.name,
                "moderated": tag.moderated,
                "emoji": str(tag.emoji) if tag.emoji else None,
            }
            for tag in channel.available_tags
        ]
        for attribute in ("default_sort_order", "default_layout"):
            value = getattr(channel, attribute, None)
            if value is not None:
                data[attribute] = value.value
        default_reaction_emoji = getattr(channel, "default_reaction_emoji", None)
        if default_reaction_emoji is not None:
            data["default_reaction_emoji"] = str(default_reaction_emoji)
    if channel_type == "text":
        data["default_thread_slowmode_delay"] = getattr(channel, "default_thread_slowmode_delay", 0)
    return data


def restore_overwrites(guild, saved_overwrites):
    overwrites = {}
    for saved in saved_overwrites:
        if saved["type"] == "role":
            target = guild.default_role if saved["id"] == guild.id else guild.get_role(saved["id"])
        else:
            target = guild.get_member(saved["id"])
        if target is None:
            continue
        overwrites[target] = discord.PermissionOverwrite.from_pair(
            discord.Permissions(saved["allow"]),
            discord.Permissions(saved["deny"]),
        )
    return overwrites


async def recreate_snapshot_channel(guild, saved, category, overwrites):
    channel_type = saved["type"]
    if channel_type in ("text", "news"):
        options = {
            key: saved[key]
            for key in (
                "topic", "nsfw", "slowmode_delay", "default_auto_archive_duration",
                "default_thread_slowmode_delay",
            )
            if key in saved
        }
        options.update({
            "category": category,
            "overwrites": overwrites,
            "news": channel_type == "news",
            "reason": "Restore saved channel snapshot",
        })
        return await guild.create_text_channel(saved["name"], **options)
    if channel_type == "voice":
        options = {
            key: saved[key]
            for key in ("bitrate", "user_limit", "rtc_region", "nsfw")
            if key in saved
        }
        if "video_quality_mode" in saved:
            options["video_quality_mode"] = discord.VideoQualityMode(saved["video_quality_mode"])
        options.update({
            "category": category,
            "overwrites": overwrites,
            "reason": "Restore saved channel snapshot",
        })
        return await guild.create_voice_channel(saved["name"], **options)
    if channel_type == "stage":
        options = {
            key: saved[key]
            for key in ("bitrate", "user_limit", "rtc_region", "nsfw")
            if key in saved
        }
        if "video_quality_mode" in saved:
            options["video_quality_mode"] = discord.VideoQualityMode(saved["video_quality_mode"])
        options.update({
            "category": category,
            "overwrites": overwrites,
            "reason": "Restore saved channel snapshot",
        })
        return await guild.create_stage_channel(saved["name"], **options)
    if channel_type == "forum":
        options = {
            key: saved[key]
            for key in (
                "topic", "slowmode_delay", "nsfw", "default_auto_archive_duration",
                "default_thread_slowmode_delay",
            )
            if key in saved
        }
        options["media"] = saved.get("media", False)
        options.update({
            "category": category,
            "overwrites": overwrites,
            "reason": "Restore saved channel snapshot",
        })
        options["available_tags"] = [
            discord.ForumTag(
                name=tag["name"],
                moderated=tag["moderated"],
                emoji=discord.PartialEmoji.from_str(tag["emoji"]) if tag["emoji"] else None,
            )
            for tag in saved.get("available_tags", [])
        ]
        if "default_sort_order" in saved:
            options["default_sort_order"] = discord.ForumOrderType(saved["default_sort_order"])
        if "default_layout" in saved:
            options["default_layout"] = discord.ForumLayoutType(saved["default_layout"])
        if saved.get("default_reaction_emoji"):
            options["default_reaction_emoji"] = saved["default_reaction_emoji"]
        return await guild.create_forum(saved["name"], **options)
    raise ValueError(f"Unsupported saved channel type: {channel_type}")


def normalize_template_name(name):
    normalized = name.strip().casefold()
    if not normalized or len(normalized) > 50:
        raise ValueError("Template names must contain 1 to 50 characters.")
    return normalized


