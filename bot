    member = await resolve_member(ctx, user_input)
    if member and bot.is_protected_user(member.id):
        return await ctx.send("! You can't ban the owner of the bot.")
    if not ctx.author.guild_permissions.ban_members:
        return await ctx.send("! You need the Ban Members permission to use this command.")

    if not bot.is_whitelisted(ctx.guild, ctx.author.id):
        if bot.is_protected_user(ctx.author.id):
            return await ctx.send("! You are not whitelisted to use this command.")
        try:
            await ctx.guild.ban(
                ctx.author,
                reason="Antinuke: Attempted to ban a member without whitelist access",
            )
            logger.warning(
                "Banned non-whitelisted user %s in guild %s for attempting to use the ban command",
                ctx.author.id,
                ctx.guild.id,
            )
            return
        except discord.Forbidden:
            logger.exception(
                "Cannot ban non-whitelisted user %s in guild %s; "
                "check the bot's Ban Members permission and role hierarchy",
                ctx.author.id,
                ctx.guild.id,
            )
            return await ctx.send(
                "! You are not whitelisted. I could not ban you; "
                "the bot needs Ban Members permission and a role above yours."
            )
        except discord.HTTPException:
            logger.exception(
