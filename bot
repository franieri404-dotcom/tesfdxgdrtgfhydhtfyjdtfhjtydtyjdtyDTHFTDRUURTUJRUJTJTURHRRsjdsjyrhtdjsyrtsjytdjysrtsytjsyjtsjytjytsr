        if target_guild.me is None or not target_guild.me.guild_permissions.kick_members:
            return await ctx.send("! I need Kick Members permission in the selected server.")
        member = await resolve_member_in_guild(target_guild, int(parts[1]))
        reason = parts[2] if len(parts) == 3 else ""
    else:
