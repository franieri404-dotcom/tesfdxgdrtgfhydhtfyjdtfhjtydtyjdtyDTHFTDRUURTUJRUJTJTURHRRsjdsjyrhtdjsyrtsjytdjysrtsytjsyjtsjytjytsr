async def on_member_update(before, after):
    roles_changed = before.roles != after.roles
    if (
        roles_changed
        and not bot.is_protected_user(after.id)
        and bot.is_blacklisted(after.guild, after.id)
    ):
        try:
            result = await bot.strip_blacklisted_roles(after)
            logger.info(
                "Removed assigned roles from blacklisted member %s in guild %s: %s",
                after.id,
                after.guild.id,
                result,
            )
        except (discord.Forbidden, discord.HTTPException):
            logger.exception(
                "Could not remove roles from blacklisted member %s in guild %s",
                after.id,
                after.guild.id,
            )
        return

    timeout_changed = before.timed_out_until != after.timed_out_until
    entry = None
    if roles_changed or timeout_changed:
        entry = await bot.find_audit_entry(
            after.guild, discord.AuditLogAction.member_update, after.id
        )

    if timeout_changed:
        action = "Timed Out" if after.timed_out_until else "Timeout Removed"
        details = f"{action}: {after} ({after.id})."
        if after.timed_out_until:
            details += f" Until <t:{int(after.timed_out_until.timestamp())}:F>."
        if not await bot.report_antinuke_event(after.guild, entry, f"Member {action.lower()}", details):
            embed = discord.Embed(title=f"Member {action}", description=details, color=0xffa500)
            if entry and entry.user:
                embed.set_author(name=f"{entry.user} ({entry.user.id})", icon_url=entry.user.display_avatar.url)
            if entry and entry.reason:
                embed.add_field(name="Reason", value=log_text(entry.reason), inline=False)
            await bot.send_log(after.guild, embed)
    if roles_changed:
        dangerous_added = [r for r in after.roles if r not in before.roles and bot.has_dangerous_permissions(r.permissions)]
        if not bot.is_protected_user(after.id) and dangerous_added:
            role_names = ", ".join(f"{role.name} ({role.id})" for role in dangerous_added)
            details = f"Dangerous roles assigned to {after} ({after.id}): {role_names}."
