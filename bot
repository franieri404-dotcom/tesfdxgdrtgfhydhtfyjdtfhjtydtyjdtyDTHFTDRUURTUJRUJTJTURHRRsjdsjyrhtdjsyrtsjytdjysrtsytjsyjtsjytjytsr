                await after.remove_roles(
                    *dangerous_added,
                    reason="Antinuke: removing unauthorized dangerous role assignment",
                )
                return "Unauthorized dangerous role assignment removed."

            if await bot.enforce_antinuke_action(
                after.guild, entry, "Unauthorized dangerous role assignment", details, remove_dangerous_roles
            ):
                return

        added_roles = [r for r in after.roles if r not in before.roles and not r.is_default()]
        removed_roles = [r for r in before.roles if r not in after.roles and not r.is_default()]
