    async def _load_user_cache(self, table):
        async with self.db.execute(f"SELECT guild_id, user_id FROM {table}") as cursor:
            values = {}
            for guild_id, user_id in await cursor.fetchall():
                values.setdefault(guild_id, set()).add(user_id)
        return values

    async def on_connect(self):
        logger.info("Connected to Discord gateway; waiting for bot to become ready.")

    async def on_ready(self):
        if not self._ready_logged:
            logger.info("Connected to Discord as %s (ID: %s)", self.user, self.user.id)
            logger.info("SQLite database: %s", DATABASE_PATH)
            for guild in self.guilds:
                bot_member = guild.me
                if bot_member is None or not bot_member.guild_permissions.view_audit_log:
                    logger.warning(
                        "Antinuke detection is limited in guild %s (%s): grant the bot View Audit Log permission",
                        guild.name,
                        guild.id,
                    )
            self._ready_logged = True

    async def on_disconnect(self):
        logger.warning("Disconnected from Discord gateway; attempting to reconnect.")

    async def close(self):
        if self._status_task is not None and not self._status_task.done():
            self._status_task.cancel()
            try:
                await self._status_task
            except asyncio.CancelledError:
                pass
        try:
            if self.db is not None:
                await self.db.close()
                self.db = None
        finally:
            await super().close()

    async def status_task(self):
        await self.wait_until_ready()
        index = 0
        while not self.is_closed():
            try:
                await self.change_presence(
                    status=STATUS_PRESENCES[index % len(STATUS_PRESENCES)],
                    activity=discord.CustomActivity(name=STATUS_MESSAGES[index % len(STATUS_MESSAGES)])
                )
            except discord.HTTPException:
                logger.exception("Presence update failed")
            index = (index + 1) % max(len(STATUS_MESSAGES), len(STATUS_PRESENCES))
            await asyncio.sleep(15)

