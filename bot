@bot.event
async def on_raw_message_edit(payload):
    if not payload.guild_id:
        return
    guild = bot.get_guild(payload.guild_id)
    if guild is None:
        return

    message = payload.cached_message
    data = payload.data
    before_content = message.content if message else None
    content_in_payload = "content" in data
    after_content = data.get("content")
    old_attachments = [str(item.id) for item in message.attachments] if message else None
    attachment_data = data.get("attachments")
    new_attachments = [str(item.get("id")) for item in attachment_data] if attachment_data is not None else None
    content_changed = content_in_payload and (before_content is None or before_content != after_content)
    attachments_changed = attachment_data is not None and (old_attachments is None or old_attachments != new_attachments)
    if message and not content_changed and not attachments_changed:
        return

    embed = discord.Embed(title="Message Edited", color=0xffa500, timestamp=discord.utils.utcnow())
    embed.add_field(name="Channel", value=f"<#{payload.channel_id}>", inline=True)
    embed.add_field(name="Message ID", value=str(payload.message_id), inline=True)
    author = message.author if message else None
    if author:
        embed.add_field(name="Author", value=f"{author} ({author.id})", inline=False)
    if content_in_payload:
        embed.add_field(name="Before", value=log_text(before_content if before_content is not None else "Unavailable (message not cached)"), inline=False)
        embed.add_field(name="After", value=log_text(after_content), inline=False)
    if attachments_changed:
        old_files = ", ".join(item.filename for item in message.attachments) if message else "Unavailable (message not cached)"
        new_files = ", ".join(item.get("filename", "unknown") for item in attachment_data)
        embed.add_field(name="Attachments before", value=log_text(old_files), inline=False)
        embed.add_field(name="Attachments after", value=log_text(new_files), inline=False)
    await bot.send_log(guild, embed)


