def main():
    token = ""
    for variable in ("DISCORD_BOT_TOKEN", "DISCORD_TOKEN", "BOT_TOKEN", "TOKEN"):
        token = os.getenv(variable, "").strip()
        if token:
            logger.info("Found bot token in environment variable %s.", variable)
            break
    if not token:
        if not sys.stdin.isatty():
            logger.critical(
                "No bot token is configured in DISCORD_BOT_TOKEN or the hosting "
                "environment, and no interactive console is available. Add your "
                "token to the DISCORD_BOT_TOKEN environment variable."
            )
            raise SystemExit(1)
        try:
            token = getpass.getpass("Enter your Discord bot token (input hidden): ").strip()
        except (EOFError, OSError):
            logger.critical(
                "Could not read a token from this window. Set DISCORD_BOT_TOKEN "
                "in the environment or launch the bot from a terminal."
            )
            raise SystemExit(1) from None
    if not token:
        logger.critical("No token was entered. The bot was not started.")
        raise SystemExit(1)
    try:
        logger.info("Starting Discord client.")
        bot.run(token)
    except discord.LoginFailure:
        logger.critical(
            "Discord rejected the bot token. Copy the bot token from the Discord "
            "Developer Portal and try again; do not share it with anyone."
        )
        raise SystemExit(1) from None
    except discord.PrivilegedIntentsRequired:
        logger.critical(
            "Discord requires privileged intents for this bot. In the Discord "
            "Developer Portal, open your application > Bot > Privileged Gateway "
            "Intents and enable Server Members Intent and Message Content Intent. "
            "The Guild Moderation intent is enabled in the bot code for live audit-log events."
        )
        raise SystemExit(1) from None
    except Exception:
        logger.exception(
            "Bot startup or connection failed. Check the error above, your "
            "internet connection, and the bot's Discord Developer Portal settings."
        )
        raise SystemExit(1) from None


