@bot.event
async def on_guild_channel_update(before, after):
    changes = []
    for attribute, label in (
        ("name", "Name"),
        ("category", "Category"),
        ("topic", "Topic"),
        ("position", "Position"),
        ("nsfw", "NSFW"),
        ("slowmode_delay", "Slowmode"),
        ("bitrate", "Bitrate"),
        ("user_limit", "User limit"),
    ):
        old_value = getattr(before, attribute, None)
        new_value = getattr(after, attribute, None)
        if old_value != new_value:
            if attribute == "category":
                old_value = getattr(old_value, "name", None)
                new_value = getattr(new_value, "name", None)
            changes.append(f"{label}: {old_value} -> {new_value}")

    old_overwrites = before.overwrites
    new_overwrites = after.overwrites
    for target in set(old_overwrites) | set(new_overwrites):
        old_overwrite = old_overwrites.get(target, discord.PermissionOverwrite())
        new_overwrite = new_overwrites.get(target, discord.PermissionOverwrite())
        if old_overwrite != new_overwrite:
            changes.append(f"Permission overwrite for {target}: {old_overwrite} -> {new_overwrite}")

    if not changes:
        return

    embed = discord.Embed(title="Channel Updated", color=0x0000ff)
    embed.add_field(name="Channel", value=f"{after.mention} ({after.id})", inline=False)
    embed.add_field(name="Changes", value=log_text("\n".join(changes)), inline=False)
    try:
        async for entry in after.guild.audit_logs(limit=5, action=discord.AuditLogAction.channel_update):
            if getattr(entry.target, "id", None) == after.id:
                if entry.user:
                    embed.set_author(name=f"{entry.user} ({entry.user.id})", icon_url=entry.user.display_avatar.url)
                break
    except discord.Forbidden:
        pass
    await bot.send_log(after.guild, embed)



