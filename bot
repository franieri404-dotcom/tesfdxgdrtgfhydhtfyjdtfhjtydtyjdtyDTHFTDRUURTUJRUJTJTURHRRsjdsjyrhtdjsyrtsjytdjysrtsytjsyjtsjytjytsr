@bot.check
async def antinuke_command_access(ctx):
    command_root = ctx.command.qualified_name.split()[0]
    if command_root == "wl":
        if ctx.guild and bot.can_manage_whitelist(ctx.guild, ctx.author.id):
            return True
        await ctx.send("! Only the server owner or the authorized whitelist manager can manage the whitelist.")
        return False
    if command_root in WHITELIST_REQUIRED_COMMANDS:
        if ctx.guild and await bot.is_whitelisted(ctx.guild, ctx.author.id):
            return True
        await ctx.send("! Only whitelisted members can use this command.")
        return False
    if command_root not in ANTINUKE_COMMAND_ROOTS:
        return True
    if ctx.guild and await bot.is_an_admin(ctx.guild, ctx.author.id):
        return True
    await ctx.send("! Only antinuke admins, the server owner, or the authorized user can use this command.")
    return False

