    return None


def format_command_error(exc: Exception, action: str, not_found_message: str):
    if isinstance(exc, discord.NotFound):
        return not_found_message
    if isinstance(exc, discord.HTTPException) and getattr(exc, 'status', None) == 404:
        return not_found_message
    text = str(exc)
    if any(term in text for term in ["404 Not Found", "Unknown Ban", "Unknown User", "Unknown Member", "10026"]):
        return not_found_message
    return not_found_message

